FROM python:3.12-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends can-utils iproute2 gcc libc6-dev && rm -rf /var/lib/apt/lists/*
COPY requirements.txt* ./
RUN pip install --no-cache-dir python-can pytest || true
COPY . /app
ENV CAN_INTERFACE=vcan0
CMD ["python3", "multi_node_cluster.py"]

